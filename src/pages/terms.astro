<style>
  .legal { max-width: 74ch; margin: 0 auto; padding: 96px 24px 120px; font-family: var(--sr-font-body, system-ui), sans-serif; color: #2e2b26; }
  .legal h1 { font-family: var(--sr-font-serif, Georgia), serif; font-size: clamp(32px, 5vw, 46px); font-weight: 600; margin: 0 0 8px; text-wrap: balance; }
  .legal h2 { font-family: var(--sr-font-serif, Georgia), serif; font-size: 22px; font-weight: 600; margin: 38px 0 10px; }
  .legal p { font-size: 16px; line-height: 1.8; margin: 0 0 14px; }
  .legal .updated { font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: #86827a; margin-bottom: 30px; }
  .legal a { color: var(--sr-red, #b3261e); }
</style>
