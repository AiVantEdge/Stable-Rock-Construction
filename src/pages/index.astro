---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeScreen from '../components/HomeScreen.jsx';
import { PAGE_META, homeSchema } from '../data/seo.js';

const m = PAGE_META.home;
---
<BaseLayout title={m.title} description={m.description} path={m.path} active="home" schema={homeSchema()}>
  <HomeScreen client:load />
</BaseLayout>
