---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LOCATIONS } from '../../../data/locations.js';
import { SITE, businessNode, founderNode } from '../../../data/seo.js';
import { localizedPath } from '../../../i18n/ui.js';

const title = 'Áreas de Servicio en Miami, los Cayos y SWFL | Stable Rock Construction';
const description = 'Stable Rock Construction atiende el Condado de Miami-Dade, los Cayos de Florida y el suroeste de Florida — techos, plomería, A/C, ventanas de impacto y remodelaciones. Empresa de veteranos, certificada por el Estado de Florida.';
const path = '/service-areas';

const groups = [
  { label: 'Condado de Miami-Dade', region: 'Miami-Dade County' },
  { label: 'Cayos de Florida', region: 'Florida Keys' },
  { label: 'Suroeste de Florida', region: 'Southwest Florida' },
].map((g) => ({ ...g, cities: LOCATIONS.filter((l) => l.region === g.region) }));

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    businessNode,
    founderNode,
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE + '/es' },
      { '@type': 'ListItem', position: 2, name: 'Áreas de Servicio', item: SITE + '/es/service-areas' },
    ]},
  ],
};
---
<BaseLayout title={title} description={description} path={path} active="home" lang="es" schema={schema}>
  <section style="background: var(--sr-charcoal); color: #fff;">
    <div style="max-width: var(--sr-container); margin: 0 auto; padding: clamp(140px,18vh,210px) var(--sr-gutter) clamp(48px,7vh,80px);">
      <p style="font-family: var(--sr-font-body); font-size: 11.5px; letter-spacing: var(--sr-tracking-meta); text-transform: uppercase; color: rgba(255,255,255,0.65); margin: 0 0 18px;">
        <a href="/es" style="color: rgba(255,255,255,0.65); text-decoration: none;">Inicio</a> / Áreas de Servicio
      </p>
      <h1 style="font-family: var(--sr-font-display); font-weight: 700; text-transform: uppercase; font-size: clamp(34px,5.2vw,70px); line-height: 1; color: #fff; margin: 0;">
        Dónde trabajamos.
      </h1>
      <p style="font-family: var(--sr-font-body); font-size: var(--sr-size-lead); line-height: var(--sr-leading-body); color: #e7e4dd; max-width: var(--sr-measure-lead); margin: 24px 0 0;">
        Empresa de veteranos, certificada por el Estado de Florida, al servicio del Condado de Miami-Dade, los Cayos de Florida y el suroeste de Florida, con cada oficio bajo una sola licencia.
      </p>
    </div>
  </section>

  <section style="padding: var(--sr-section-y) var(--sr-gutter);">
    <div style="max-width: var(--sr-container); margin: 0 auto; display: flex; flex-wrap: wrap; gap: clamp(32px,4vw,56px);">
      {groups.map((group) => (
        <div style="flex: 1 1 280px;">
          <p style="font-family: var(--sr-font-body); font-size: var(--sr-size-label); font-weight: 600; letter-spacing: var(--sr-tracking-eyebrow); text-transform: uppercase; color: var(--sr-red); margin: 0 0 18px;">{group.label}</p>
          <div style="display: flex; flex-direction: column; gap: 2px; border-top: var(--sr-rule-hairline);">
            {group.cities.map((c) => (
              <a href={localizedPath(`/service-areas/${c.slug}`, 'es')} style="font-family: var(--sr-font-display); font-weight: 600; text-transform: uppercase; font-size: 18px; letter-spacing: 0.03em; color: var(--sr-ink); text-decoration: none; padding: 14px 0; border-bottom: var(--sr-rule-hairline);">{c.name} &rarr;</a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
