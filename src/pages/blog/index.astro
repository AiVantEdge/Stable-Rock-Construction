---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE, businessNode, founderNode } from '../../data/seo.js';

const title = 'Guides: Roofing, Windows & Home Advice | Stable Rock Construction';
const description = 'Practical guides for South Florida homeowners on roofing, impact windows, plumbing, HVAC, permits, and remodels — from a Florida state-certified, veteran-owned contractor.';
const path = '/blog';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const fmt = (d) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    businessNode,
    founderNode,
    { '@type': 'Blog', '@id': SITE + '/blog', name: 'Stable Rock Construction Guides', url: SITE + '/blog', publisher: { '@id': SITE + '/#business' } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE + '/' },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: SITE + '/blog' },
    ]},
  ],
};
---
<BaseLayout title={title} description={description} path={path} active="home" schema={schema}>
  <section style="background: var(--sr-charcoal); color: #fff;">
    <div style="max-width: var(--sr-container); margin: 0 auto; padding: clamp(140px,18vh,210px) var(--sr-gutter) clamp(48px,7vh,80px);">
      <p style="font-family: var(--sr-font-body); font-size: 11.5px; letter-spacing: var(--sr-tracking-meta); text-transform: uppercase; color: rgba(255,255,255,0.65); margin: 0 0 18px;">
        <a href="/" style="color: rgba(255,255,255,0.65); text-decoration: none;">Home</a> / Guides
      </p>
      <h1 style="font-family: var(--sr-font-display); font-weight: 700; text-transform: uppercase; font-size: clamp(34px,5.2vw,70px); line-height: 1; color: #fff; margin: 0;">
        Guides.
      </h1>
      <p style="font-family: var(--sr-font-body); font-size: var(--sr-size-lead); line-height: var(--sr-leading-body); color: #e7e4dd; max-width: var(--sr-measure-lead); margin: 24px 0 0;">
        Straight answers for South Florida homeowners on roofing, windows, plumbing, HVAC, permits, and remodels.
      </p>
    </div>
  </section>

  <section style="padding: var(--sr-section-y) var(--sr-gutter);">
    <div style="max-width: 940px; margin: 0 auto; border-top: var(--sr-rule-hairline);">
      {posts.map((post) => (
        <a href={`/blog/${post.id}`} style="display: block; padding: clamp(24px,3vw,34px) 0; border-bottom: var(--sr-rule-hairline); text-decoration: none; color: var(--sr-ink);">
          <p style="font-family: var(--sr-font-body); font-size: 11.5px; letter-spacing: var(--sr-tracking-meta); text-transform: uppercase; color: var(--sr-muted); margin: 0 0 10px;">{fmt(post.data.pubDate)}</p>
          <h2 style="font-family: var(--sr-font-display); font-weight: 700; text-transform: uppercase; font-size: clamp(22px,2.6vw,32px); line-height: 1.08; margin: 0 0 10px;">{post.data.title}</h2>
          <p style="font-family: var(--sr-font-body); font-size: 16px; line-height: 1.7; color: var(--sr-muted); margin: 0 0 12px; max-width: 68ch;">{post.data.description}</p>
          <span style="font-family: var(--sr-font-body); font-size: 12px; font-weight: 600; letter-spacing: var(--sr-tracking-button); text-transform: uppercase; color: var(--sr-red);">Read guide &rarr;</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
