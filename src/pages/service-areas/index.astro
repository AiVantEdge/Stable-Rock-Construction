---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCATIONS } from '../../data/locations.js';
import { SITE, businessNode, founderNode } from '../../data/seo.js';

const title = 'Service Areas in Miami, the Keys & SWFL | Stable Rock Construction';
const description = 'Stable Rock Construction serves Miami-Dade County, the Florida Keys, and Southwest Florida — roofing, plumbing, HVAC, impact windows, and remodels. Veteran-owned and Florida state-certified.';
const path = '/service-areas';

const regions = ['Miami-Dade County', 'Florida Keys', 'Southwest Florida'];
const byRegion = regions.map((r) => ({ region: r, cities: LOCATIONS.filter((l) => l.region === r) }));

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    businessNode,
    founderNode,
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE + '/' },
        { '@type': 'ListItem', position: 2, name: 'Service Areas', item: SITE + '/service-areas' },
      ],
    },
  ],
};
---
<BaseLayout title={title} description={description} path={path} active="home" schema={schema}>
  <section style="background: var(--sr-charcoal); color: #fff;">
    <div style="max-width: var(--sr-container); margin: 0 auto; padding: clamp(140px,18vh,210px) var(--sr-gutter) clamp(48px,7vh,80px);">
      <p style="font-family: var(--sr-font-body); font-size: 11.5px; letter-spacing: var(--sr-tracking-meta); text-transform: uppercase; color: rgba(255,255,255,0.65); margin: 0 0 18px;">
        <a href="/" style="color: rgba(255,255,255,0.65); text-decoration: none;">Home</a> / Service Areas
      </p>
      <h1 style="font-family: var(--sr-font-display); font-weight: 700; text-transform: uppercase; font-size: clamp(34px,5.2vw,70px); line-height: 1; color: #fff; margin: 0;">
        Where we work.
      </h1>
      <p style="font-family: var(--sr-font-body); font-size: var(--sr-size-lead); line-height: var(--sr-leading-body); color: #e7e4dd; max-width: var(--sr-measure-lead); margin: 24px 0 0;">
        Veteran-owned and Florida state-certified, serving Miami-Dade County, the Florida Keys, and Southwest Florida with every trade under one license.
      </p>
    </div>
  </section>

  <section style="padding: var(--sr-section-y) var(--sr-gutter);">
    <div style="max-width: var(--sr-container); margin: 0 auto; display: flex; flex-wrap: wrap; gap: clamp(32px,4vw,56px);">
      {byRegion.map((group) => (
        <div style="flex: 1 1 280px;">
          <p style="font-family: var(--sr-font-body); font-size: var(--sr-size-label); font-weight: 600; letter-spacing: var(--sr-tracking-eyebrow); text-transform: uppercase; color: var(--sr-red); margin: 0 0 18px;">{group.region}</p>
          <div style="display: flex; flex-direction: column; gap: 2px; border-top: var(--sr-rule-hairline);">
            {group.cities.map((c) => (
              <a href={`/service-areas/${c.slug}`} style="font-family: var(--sr-font-display); font-weight: 600; text-transform: uppercase; font-size: 18px; letter-spacing: 0.03em; color: var(--sr-ink); text-decoration: none; padding: 14px 0; border-bottom: var(--sr-rule-hairline);">{c.name} &rarr;</a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
